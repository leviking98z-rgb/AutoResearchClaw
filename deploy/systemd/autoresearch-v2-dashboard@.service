[Unit]
Description=AutoResearch v2 dashboard (%i)
After=network-online.target autoresearch-v2@%i.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/data/workspace/autoresearch-stack/AutoResearchClaw-prod
Environment=HOME=/root
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/autoresearch-v2/%i.env
ExecStartPre=/usr/bin/test -f ${AUTORESEARCH_V2_CONFIG}
ExecStart=/data/workspace/autoresearch-stack/AutoResearchClaw-prod/.venv/bin/python -m researchclaw.autoresearch_v2.dashboard --config ${AUTORESEARCH_V2_CONFIG} --host ${AUTORESEARCH_V2_DASHBOARD_HOST} --port ${AUTORESEARCH_V2_DASHBOARD_PORT}
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
ReadWritePaths=/root/shared/.clusters /data/workspace/autoresearch-stack/AutoResearchClaw-prod/workspace

[Install]
WantedBy=multi-user.target
