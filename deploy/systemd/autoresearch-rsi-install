#!/usr/bin/env python3
"""Install persistent RSI systemd templates without starting production."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

REPO_DEFAULT = Path("/data/workspace/autoresearch-stack/AutoResearchClaw")
UNIT_NAMES = (
    "autoresearch-rsi.target",
    "autoresearch-rsi-alert@.service",
    "autoresearch-rsi-supervisor@.service",
    "autoresearch-rsi-monitor@.service",
    "autoresearch-rsi-keepalive@.service",
)
EXECUTABLE_NAMES = (
    "autoresearch-rsi-alert",
    "autoresearch-rsi-supervisor-run",
    "autoresearch-rsi-monitor-run",
    "autoresearch-rsi-keepalive-run",
    "autoresearch-rsi-guard",
    "autoresearch-rsi-control",
    "autoresearch-rsi-install",
)


def quote_env(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def atomic_write(path: Path, text: str, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, raw_tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    tmp = Path(raw_tmp)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass


def read_campaign(campaign_dir: Path) -> dict[str, object]:
    path = campaign_dir / "campaign.json"
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        raise ValueError(f"{path} must contain a JSON object")
    return value


def build_environment(
    *,
    campaign_dir: Path,
    campaign: dict[str, object],
    repo_root: Path,
    owner: str,
    nodes: str,
    purpose: str,
    pool_config: Path,
    lease_heartbeat: Path,
) -> str:
    campaign_id = str(campaign.get("campaign_id") or campaign_dir.name)
    values = {
        "RSI_CAMPAIGN_ID": campaign_id,
        "RSI_CAMPAIGN_DIR": str(campaign_dir),
        "RSI_REPO_ROOT": str(repo_root),
        "RSI_SUPERVISOR_PYTHON": "/usr/bin/python3",
        "RSI_MONITOR_PYTHON": str(repo_root / ".venv" / "bin" / "python"),
        "RSI_POOL_CONFIG": str(pool_config),
        "RSI_NODES": nodes,
        "RSI_EXPECTED_GPUS_PER_NODE": "8",
        "RSI_EXPECTED_CLAIM_OWNER": owner,
        "RSI_EXPECTED_CLAIM_PURPOSE": purpose,
        # Boot-restored systemd processes have no interactive agent parent
        # chain. Preserve the allocation identity for both config expansion
        # and ClusterBridge's detached-process owner resolution.
        "AUTORESEARCH_CLAIM_OWNER": owner,
        "CB_SID": owner,
        "RSI_LEASE_HEARTBEAT": str(lease_heartbeat),
        "RSI_MONITOR_COMMAND_TIMEOUT_SEC": "120",
        "RSI_MONITOR_POOL_PROBE_TIMEOUT_SEC": "90",
        "RSI_MONITOR_EXTERNAL_DEADLINE_SEC": "110",
        "RSI_MONITOR_INTERVAL_SEC": "30",
        "RSI_PIPELINE_PROGRESS_STALE_SEC": "14400",
        "AUTORESEARCH_LEASE_OWNER": owner,
        "AUTORESEARCH_LEASE_PURPOSE": purpose,
        "AUTORESEARCH_LEASE_NODES": nodes,
        "AUTORESEARCH_LEASE_TTL_MIN": "180",
        "AUTORESEARCH_LEASE_RENEW_INTERVAL_SEC": "1800",
    }
    return "".join(f"{key}={quote_env(value)}\n" for key, value in values.items())


def install_files(source_dir: Path, unit_dir: Path) -> None:
    unit_dir.mkdir(parents=True, exist_ok=True)
    for name in UNIT_NAMES:
        source = source_dir / name
        destination = unit_dir / name
        text = source.read_text(encoding="utf-8")
        atomic_write(destination, text, 0o644)
    for name in EXECUTABLE_NAMES:
        source = source_dir / name
        mode = stat.S_IMODE(source.stat().st_mode)
        if not mode & stat.S_IXUSR:
            os.chmod(source, mode | 0o755)


def verify_units(unit_dir: Path) -> None:
    command = shutil.which("systemd-analyze")
    if not command:
        raise RuntimeError("systemd-analyze is not installed")
    subprocess.run(
        [command, "verify", *[str(unit_dir / name) for name in UNIT_NAMES]],
        check=True,
    )


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Install AutoResearch RSI systemd templates and one instance "
            "environment. Units are not started or restarted."
        )
    )
    parser.add_argument("--campaign", required=True, type=Path)
    parser.add_argument("--instance")
    parser.add_argument("--repo-root", type=Path, default=REPO_DEFAULT)
    parser.add_argument("--owner", required=True)
    parser.add_argument(
        "--nodes",
        default="28.83.2.169,28.83.50.39,28.85.33.47,28.85.50.103",
    )
    parser.add_argument(
        "--purpose",
        default="AutoResearch RSI 32-GPU execution pool",
    )
    parser.add_argument("--pool-config", type=Path)
    parser.add_argument(
        "--lease-heartbeat",
        type=Path,
        default=Path(
            "/root/shared/.clusters/.tmp/autoresearch-rsi/"
            "lease-keepalive-heartbeat.json"
        ),
    )
    parser.add_argument(
        "--unit-dir",
        type=Path,
        default=Path("/etc/systemd/system"),
    )
    parser.add_argument(
        "--env-dir",
        type=Path,
        default=Path("/etc/autoresearch-rsi"),
    )
    parser.add_argument(
        "--no-daemon-reload",
        action="store_true",
        help="write and verify files without systemctl daemon-reload",
    )
    args = parser.parse_args()

    campaign_dir = args.campaign.expanduser().resolve()
    repo_root = args.repo_root.expanduser().resolve()
    campaign = read_campaign(campaign_dir)
    instance = args.instance or str(
        campaign.get("campaign_id") or campaign_dir.name
    )
    if instance != str(campaign.get("campaign_id") or campaign_dir.name):
        parser.error("--instance must match campaign.json campaign_id")
    if "/" in instance or not instance:
        parser.error("instance must be a non-empty systemd-safe campaign ID")
    pool_config = (
        args.pool_config.expanduser().resolve()
        if args.pool_config
        else repo_root / "config.cluster32.yaml"
    )
    if not pool_config.is_file():
        parser.error(f"pool config not found: {pool_config}")

    source_dir = Path(__file__).resolve().parent
    install_files(source_dir, args.unit_dir)
    env_text = build_environment(
        campaign_dir=campaign_dir,
        campaign=campaign,
        repo_root=repo_root,
        owner=args.owner,
        nodes=args.nodes,
        purpose=args.purpose,
        pool_config=pool_config,
        lease_heartbeat=args.lease_heartbeat.expanduser().resolve(),
    )
    env_path = args.env_dir / f"{instance}.env"
    atomic_write(env_path, env_text, 0o600)
    alert_env_path = args.env_dir / "alerts.env"
    if not alert_env_path.exists():
        atomic_write(
            alert_env_path,
            (
                f"RSI_ALERT_RECIPIENT={quote_env(args.owner)}\n"
                'RSI_ALERT_COOLDOWN_SEC="1800"\n'
            ),
            0o600,
        )
    verify_units(args.unit_dir)
    if not args.no_daemon_reload:
        subprocess.run(["systemctl", "daemon-reload"], check=True)

    print(
        json.dumps(
            {
                "instance": instance,
                "campaign_dir": str(campaign_dir),
                "environment_file": str(env_path),
                "alert_environment_file": str(alert_env_path),
                "unit_dir": str(args.unit_dir),
                "daemon_reloaded": not args.no_daemon_reload,
                "started": False,
                "enabled": False,
            },
            indent=2,
        )
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(
            f"autoresearch-rsi-install: {type(exc).__name__}: {exc}",
            file=sys.stderr,
        )
        raise SystemExit(1) from None
