[Unit]
Description=AutoResearch v2 continuous controller (%i)
After=network-online.target srv-bridge.service srv-infohub.service
Wants=network-online.target srv-bridge.service srv-infohub.service
StartLimitIntervalSec=30min
StartLimitBurst=30

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/data/workspace/autoresearch-stack/AutoResearchClaw-prod
Environment=HOME=/root
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/autoresearch-v2/%i.env
ExecStartPre=/usr/bin/test -f ${AUTORESEARCH_V2_CONFIG}
ExecStartPre=/data/workspace/autoresearch-stack/AutoResearchClaw-prod/bin/researchclaw-ensure-deps --python /data/workspace/autoresearch-stack/AutoResearchClaw-prod/.venv/bin/python
ExecStart=/data/workspace/autoresearch-stack/AutoResearchClaw-prod/.venv/bin/python -m researchclaw.autoresearch_v2.cli --config ${AUTORESEARCH_V2_CONFIG} start
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
ReadWritePaths=/root/shared/.clusters
LimitNOFILE=524288
TasksMax=infinity
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
