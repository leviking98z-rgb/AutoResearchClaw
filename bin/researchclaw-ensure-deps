#!/usr/bin/env python3
"""Ensure ResearchClaw runtime dependencies for the selected Python."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from researchclaw.runtime_dependencies import (
    dependencies_satisfied,
    ensure_runtime_dependencies,
)


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="researchclaw-ensure-deps",
        description=(
            "Check the exact Python used by ResearchClaw and install missing "
            "small runtime dependencies such as the arxiv client."
        ),
    )
    parser.add_argument("--python", default=sys.executable)
    parser.add_argument("--check-only", action="store_true")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--timeout-sec", type=float, default=300.0)
    args = parser.parse_args()

    results = ensure_runtime_dependencies(
        python_executable=args.python,
        auto_install=not args.check_only,
        timeout_sec=max(1.0, args.timeout_sec),
    )
    payload = {
        "python": str(Path(args.python).expanduser()),
        "ok": dependencies_satisfied(results),
        "dependencies": [result.to_dict() for result in results],
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print(f"Python: {payload['python']}")
        for result in results:
            print(
                f"[{result.status.upper()}] {result.module} "
                f"({result.requirement})"
                + (f" — {result.detail}" if result.detail else "")
            )
    return 0 if payload["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
