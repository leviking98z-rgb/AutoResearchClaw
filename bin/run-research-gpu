#!/usr/bin/env bash
set -euo pipefail

ROOT="/data/workspace/autoresearch-stack/AutoResearchClaw"
CB="/root/shared/.clusters/.tools/clusterbridge.sh"
NODE="${RESEARCHCLAW_GPU_NODE:-28.83.50.39}"
CONFIG="${RESEARCHCLAW_CONFIG:-$ROOT/config.gpu.yaml}"
ARTIFACT_ROOT="${RESEARCHCLAW_ARTIFACT_ROOT:-$ROOT/artifacts}"

if [[ $# -lt 1 ]]; then
  cat >&2 <<'EOF'
Usage:
  ./bin/run-research-gpu "A concrete, falsifiable GPU research question"

This wrapper claims and prepares one H20 node, runs ResearchClaw in co-pilot
mode, then restores GPU spin and releases the node on exit. It never
auto-approves paper gates.
EOF
  exit 2
fi

TOPIC="$*"
mkdir -p "$ARTIFACT_ROOT"
cd "$ROOT"
source "$ROOT/.venv/bin/activate"
export RESEARCHCLAW_ACP_MODEL="${RESEARCHCLAW_ACP_MODEL:-gpt-5.3-codex[reasoning=medium,fast=false]}"

cleanup() {
  set +e
  bash "$CB" "$NODE" run 'bash /root/shared/.clusters/.tools/node_spin.sh spin' >/dev/null 2>&1
  bash "$CB" release "$NODE" >/dev/null 2>&1
}
trap cleanup EXIT INT TERM

bash "$CB" claim "$NODE" --purpose "AutoResearchClaw GPU paper run" --ttl 480
bash "$CB" "$NODE" run \
  'set -e; bash /root/shared/.clusters/.tools/node_cleanup.sh; bash /root/shared/.clusters/.tools/node_spin.sh pause; /opt/conda/envs/torch-base/bin/python3 -c "import torch; assert torch.cuda.is_available(); print(torch.__version__, torch.cuda.get_device_name(0), torch.cuda.device_count())"'

STAMP="$(date -u +%Y%m%d-%H%M%S)"
SLUG="$(printf '%s' "$TOPIC" | sha256sum | cut -c1-8)"
OUT="$ARTIFACT_ROOT/gpu-$STAMP-$SLUG"

researchclaw run \
  --config "$CONFIG" \
  --topic "$TOPIC" \
  --output "$OUT" \
  --mode co-pilot \
  --no-graceful-degradation
